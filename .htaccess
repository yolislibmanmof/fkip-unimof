# FKIP UNIMOF - Apache security rules

# Disable directory listings
Options -Indexes

RewriteEngine On

# Block internal application and data directories from direct web access
RewriteRule ^(includes|logs|database|storage)(/|$) - [F,L,NC]

# Block version-control metadata directories
RewriteRule (^|/)\.(git|svn|hg)(/|$) - [F,L,NC]

# Deny access to hidden files and sensitive backup/config/database files
<FilesMatch "(?i)(^\.|.*\.(?:sql(?:\.(?:gz|zip))?|log|ini|sh|bak|backup|old|orig|conf|config|dist|swp|tmp|sqlite3?|db))$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>