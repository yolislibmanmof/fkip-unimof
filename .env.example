# Mode aplikasi: local atau production
APP_ENV=local

# URL proyek di Laragon
APP_URL=http://localhost/fkip-unimof

# Zona waktu aplikasi
APP_TIMEZONE=Asia/Makassar

# Database lokal Laragon
DB_HOST=localhost
DB_NAME=fkip
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Identitas aplikasi
APP_NAME=FKIP UNIMOF
APP_VERSION=2.0.0

# Kosongkan agar cookie Secure otomatis mengikuti HTTPS pada konfigurasi aplikasi.
# Untuk produksi HTTPS, dapat ditetapkan SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=